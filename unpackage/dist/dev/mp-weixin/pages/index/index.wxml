<view class="page" style="{{M}}"><view class="hero" style="{{'padding-top:' + f}}"><view class="chip-row"><view class="chip primary-chip" style="{{b}}">{{a}}</view><view class="chip">🧠 {{c}}</view><view class="chip">⭐ {{d}}</view></view><text class="hero-title" style="{{e}}">今天吃什么？</text><text class="hero-subtitle">根据你的 MBTI 和星座，为你占卜今日美食</text></view><view class="fortune-card" style="{{q}}"><view class="fortune-head"><view><text class="fortune-date">{{g}}</text><text class="fortune-title">今日运势更新 🎉</text></view><view class="fortune-badge" style="{{h}}">★</view></view><view class="fortune-grid"><view class="fortune-item"><text class="fortune-icon">🍽️</text><text class="fortune-name">今日食欲</text><text class="fortune-value" style="{{j}}">{{i}}</text></view><view class="fortune-item"><text class="fortune-icon">⚡</text><text class="fortune-name">能量指数</text><text class="fortune-value" style="{{l}}">{{k}}</text></view><view class="fortune-item"><text class="fortune-icon">🌙</text><text class="fortune-name">星座运势</text><text class="fortune-value" style="{{n}}">{{m}}</text></view></view><view class="fortune-tip"><text>{{o}}</text><text>适合 {{p}} 风格的菜单</text></view></view><button class="eat-button" style="{{r}}" bindtap="{{s}}"><text class="eat-button__label">吃什么</text></button><text class="quota-text">今日剩余 {{t}} 次占卜</text><view class="proof-row"><text>🍜</text><text>🍛</text><text>🍚</text><text>🥗</text><text>🌮</text></view><text class="proof-text">已为 {{v}} 位同学占卜今日美食 ✨</text><view wx:if="{{w}}" class="draw-mask"><view class="draw-panel" style="{{y}}"><view class="draw-orbit"><view class="draw-orbit__ring"></view><view class="draw-orbit__core" style="{{x}}">🍽️</view><view class="draw-float draw-float--one">盖饭</view><view class="draw-float draw-float--two">粉面</view><view class="draw-float draw-float--three">轻食</view></view><text class="draw-title">正在帮你占卜今天吃什么</text><text class="draw-desc">AI 正在按你的 MBTI、星座和当前模式筛选推荐</text></view></view><view wx:if="{{z}}" class="result-popup-mask" bindtap="{{L}}"><view class="result-popup" style="{{J}}" catchtap="{{K}}"><view class="result-popup__glow"></view><view class="result-popup__top"><text class="result-popup__tag">{{A}}</text><text class="result-popup__time">{{B}}</text></view><text class="result-popup__name">{{C}}</text><text class="result-popup__vibe">{{D}}</text><text class="result-popup__meta">{{E}} · {{F}}</text><view class="result-popup__divider"></view><text class="result-popup__label">推荐理由</text><text class="result-popup__reason">{{G}}</text><button class="result-popup__button" style="{{H}}" bindtap="{{I}}"> 收下推荐 </button></view></view></view>