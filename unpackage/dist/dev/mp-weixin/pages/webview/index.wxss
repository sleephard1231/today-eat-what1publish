.press-feedback {
  transform: scale(1);
  transform-origin: center;
  transition: transform 0.16s ease, opacity 0.16s ease, filter 0.16s ease;
  will-change: transform;
}
.press-feedback--active {
  transform: scale(0.98);
  opacity: 0.96;
  filter: saturate(1.02);
}
button,
.back-text,
.chip,
.picker-item,
.row-item,
.service-entry,
.select-card,
.mode-card,
.school-group__header,
.campus-option,
.join-card,
.canteen-card,
.clear-button,
.save-button,
.submit-button,
.eat-button,
.result-popup__button {
  transform: scale(1);
  transform-origin: center;
  transition: transform 0.16s ease, opacity 0.16s ease, filter 0.16s ease;
  will-change: transform;
}
button:active,
.back-text:active,
.chip:active,
.picker-item:active,
.row-item:active,
.service-entry:active,
.select-card:active,
.mode-card:active,
.school-group__header:active,
.campus-option:active,
.join-card:active,
.canteen-card:active,
.clear-button:active,
.save-button:active,
.submit-button:active,
.eat-button:active,
.result-popup__button:active {
  transform: scale(0.98);
  opacity: 0.96;
  filter: saturate(1.02);
}
.page {
  min-height: 100vh;
  background: #faf8f6;
}
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 24rpx;
  padding-right: 24rpx;
}
.back-text, .top-placeholder {
  width: 120rpx;
  color: #8a7b6e;
  font-size: 28rpx;
}
.top-title {
  color: #2f241c;
  font-size: 34rpx;
  font-weight: 700;
}
.content-wrap {
  padding: 24rpx 32rpx 60rpx;
}
.agree-button {
  width: calc(100% - 64rpx);
  height: 88rpx;
  margin: 0 32rpx 48rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ff9a5c 0%, #ff7a2f 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
}