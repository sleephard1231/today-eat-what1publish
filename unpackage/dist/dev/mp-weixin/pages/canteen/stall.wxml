<view class="page" style="{{J}}"><view class="top-bar" style="{{'padding-top:' + c}}"><text class="back-text" bindtap="{{a}}">‹ 返回</text><text class="top-title">{{b}}</text><text class="top-placeholder"></text></view><view class="stall-info-card" style="{{j}}"><view class="stall-info-row"><text class="stall-info-name" style="{{'color:' + e}}">{{d}}</text><text wx:if="{{f}}" class="stall-info-category">{{g}}</text></view><text wx:if="{{h}}" class="stall-info-remark">{{i}}</text></view><view class="action-bar"><text class="dish-count-label">菜品列表 ({{k}})</text><view class="add-dish-btn" style="{{l}}" bindtap="{{m}}"><text class="add-dish-btn-text">+ 添加菜品</text></view></view><view wx:if="{{n}}" class="dish-list"><view wx:for="{{o}}" wx:for-item="dish" wx:key="m" class="dish-card" style="{{p}}"><view class="dish-main"><view class="dish-name-row"><text class="dish-name">{{dish.a}}</text><text wx:if="{{dish.b}}" class="dish-tag" style="{{dish.d}}">{{dish.c}}</text></view><view class="dish-meta"><text wx:if="{{dish.e}}" class="dish-category">{{dish.f}}</text><text wx:if="{{dish.g}}" class="dish-price">¥{{dish.h}}</text><text wx:if="{{dish.i}}" class="dish-vibe">{{dish.j}}</text></view></view><view class="dish-actions"><view class="dish-action-btn dish-edit-btn" bindtap="{{dish.k}}">编辑</view><view class="dish-action-btn dish-delete-btn" bindtap="{{dish.l}}">删除</view></view></view></view><view wx:else class="empty-state" style="{{q}}"><text class="empty-icon">🍽️</text><text class="empty-title">暂无菜品</text><text class="empty-desc">点击上方按钮添加第一道菜品吧</text></view><view wx:if="{{r}}" class="modal-mask" bindtap="{{I}}"><view class="modal-content" style="{{H}}"><text class="modal-title">{{s}}</text><view class="form-group"><text class="form-label">菜品名称 *</text><input class="form-input" placeholder="如：红烧牛腩饭" value="{{t}}" bindinput="{{v}}"/></view><view class="form-group"><text class="form-label">分类</text><input class="form-input" placeholder="如：盖饭、粉面、小炒" value="{{w}}" bindinput="{{x}}"/></view><view class="form-group"><text class="form-label">标签</text><view class="tag-options"><view wx:for="{{y}}" wx:for-item="tag" wx:key="c" class="tag-option" style="{{tag.d}}" bindtap="{{tag.e}}"><text style="{{'color:' + tag.b + ';' + ('font-size:' + '24rpx') + ';' + ('font-weight:' + '600')}}">{{tag.a}}</text></view></view></view><view class="form-group"><text class="form-label">价格 (元)</text><input class="form-input" type="digit" placeholder="如：12" value="{{z}}" bindinput="{{A}}"/></view><view class="form-group"><text class="form-label">氛围标签</text><input class="form-input" placeholder="如：酸甜开胃、香浓满足" value="{{B}}" bindinput="{{C}}"/></view><view class="modal-actions"><view class="modal-btn modal-cancel" bindtap="{{D}}">取消</view><view class="modal-btn modal-confirm" style="{{F}}" bindtap="{{G}}">{{E}}</view></view></view></view></view>