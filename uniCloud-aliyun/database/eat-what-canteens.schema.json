{
  "bsonType": "object",
  "required": ["campusName", "name"],
  "permission": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "饭堂ID，如 gzcc-tongde"
    },
    "campusName": {
      "bsonType": "string",
      "description": "所属学校名称",
      "title": "学校"
    },
    "name": {
      "bsonType": "string",
      "description": "饭堂名称，如 同德",
      "title": "饭堂名称"
    },
    "remark": {
      "bsonType": "string",
      "description": "饭堂备注/描述",
      "title": "备注"
    },
    "sort": {
      "bsonType": "int",
      "description": "排序权重，越小越靠前",
      "title": "排序"
    },
    "status": {
      "bsonType": "string",
      "description": "状态",
      "enum": ["active", "inactive"],
      "defaultValue": "active",
      "title": "状态"
    },
    "createdAt": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "title": "创建时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "updatedAt": {
      "bsonType": "timestamp",
      "description": "更新时间",
      "title": "更新时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    }
  }
}
