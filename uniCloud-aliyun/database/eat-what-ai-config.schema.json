{
  "bsonType": "object",
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "固定为 default"
    },
    "enable": {
      "bsonType": "bool",
      "description": "AI 总开关",
      "title": "AI总开关",
      "defaultValue": false
    },
    "enableNormal": {
      "bsonType": "bool",
      "description": "普通版 AI 开关",
      "title": "普通版AI",
      "defaultValue": true
    },
    "enableCampus": {
      "bsonType": "bool",
      "description": "校园版 AI 开关",
      "title": "校园版AI",
      "defaultValue": true
    },
    "provider": {
      "bsonType": "string",
      "description": "AI 服务商",
      "title": "服务商",
      "defaultValue": "dashscope"
    },
    "providerType": {
      "bsonType": "string",
      "description": "供应商类型，支持 dashscope/openai-compatible/anthropic-compatible/openai/deepseek",
      "title": "供应商类型",
      "defaultValue": "dashscope"
    },
    "providerName": {
      "bsonType": "string",
      "description": "供应商显示名称",
      "title": "供应商名称",
      "defaultValue": "通义千问 DashScope"
    },
    "remark": {
      "bsonType": "string",
      "description": "备注",
      "title": "备注"
    },
    "websiteUrl": {
      "bsonType": "string",
      "description": "官网链接",
      "title": "官网链接"
    },
    "apiUrl": {
      "bsonType": "string",
      "description": "AI API 请求地址",
      "title": "API请求地址"
    },
    "useFullUrl": {
      "bsonType": "bool",
      "description": "是否使用完整 API URL",
      "title": "完整URL",
      "defaultValue": true
    },
    "model": {
      "bsonType": "string",
      "description": "模型名称",
      "title": "模型",
      "defaultValue": "qwen-turbo"
    },
    "dailyLimit": {
      "bsonType": "int",
      "description": "单用户每日 AI 推荐次数上限",
      "title": "每日上限",
      "defaultValue": 5
    },
    "minuteLimit": {
      "bsonType": "int",
      "description": "单用户每分钟 AI 推荐次数上限",
      "title": "每分钟上限",
      "defaultValue": 2
    },
    "promptStyle": {
      "bsonType": "string",
      "description": "推荐文案风格",
      "title": "文案风格",
      "defaultValue": "朋友聊天"
    },
    "apiKey": {
      "bsonType": "string",
      "description": "AI API Key，仅云对象读取，后台读取时会掩码",
      "title": "API Key"
    },
    "usage": {
      "bsonType": "object",
      "description": "AI 调用用量统计",
      "properties": {
        "totalCalls": { "bsonType": "int", "description": "累计调用次数" },
        "totalTokens": { "bsonType": "int", "description": "累计 token" },
        "promptTokens": { "bsonType": "int", "description": "累计输入 token" },
        "completionTokens": { "bsonType": "int", "description": "累计输出 token" },
        "lastTokens": { "bsonType": "int", "description": "最近一次 token" },
        "lastTestAt": { "bsonType": "timestamp", "description": "最近测试时间" },
        "lastTestStatus": { "bsonType": "string", "description": "最近测试状态" },
        "lastTestMessage": { "bsonType": "string", "description": "最近测试信息" }
      }
    },
    "updatedBy": {
      "bsonType": "string",
      "description": "最后更新人"
    },
    "createdAt": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "defaultValue": {
        "$env": "now"
      }
    },
    "updatedAt": {
      "bsonType": "timestamp",
      "description": "更新时间",
      "defaultValue": {
        "$env": "now"
      }
    }
  }
}
